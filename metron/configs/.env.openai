# MODEL_NAME is auto-detected from <url>/v1/models when unset.
# Override with --additional-api-args MODEL_NAME=<id>
TEMPERATURE=1.0 # Can set a float value (from 0 to 2)
TOP_P=1.0 # Can set a float value (from 0 to 1)
TOP_K=-1 # Can set a int value from 0 to `vocab_size` (== -1)
LOGPROBS=false # Enable logprobs (Chat API) or set numeric value for `top_logprobs` (Completions API)
TOP_LOGPROBS=0 # Set `top_logprobs` (usually supported from 0 to 20)
NUM_SEQUENCES=1 # Number of sequences for parallel generation
STREAM='true'
STREAM_OPTIONS='{"include_usage": true}'
